service_name = "{{ consul_discovery.service_name }}"
{% if consul_discovery.client_cert is defined %}
client_cert = "{{ consul_discovery.client_cert }}"
{% endif %}
{% if consul_discovery.client_key is defined %}
client_key = "{{ consul_discovery.client_key }}"
{% endif %}
{% if consul_discovery.tls_skip_verify is defined %}
tls_skip_verify = {{ consul_discovery.tls_skip_verify | string | lower }}
{% endif %}
token = "{{ consul_discovery.token }}"
{% if consul_discovery.datacenters is defined %}
datacenters = [
  {% for datacenter in consul_discovery.datacenters %}
  "{{ datacenter }}",
  {% endfor %}
]
{% endif %}
{% if consul_discovery.tags is defined %}
tags = [
  {% for tag in consul_discovery.tags %}
  "{{ tag }}",
  {% endfor %}
]
{% endif %}
{% if consul_discovery.meta is defined %}
meta = [
  {% for meta in consul_discovery.meta %}
  "{{ meta }}",
  {% endfor %}
]
{% endif %}
{% endif %}

{% if garage_install_configuration.kubernetes_discovery is defined %}
{% set kubernetes_discovery = garage_install_configuration.kubernetes_discovery %}
[kubernetes_discovery]
