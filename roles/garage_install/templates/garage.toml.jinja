service_name = "{{ kubernetes_discovery.service_name }}"
{% if kubernetes_discovery.tls_skip_verify is defined %}
tls_skip_verify = {{ kubernetes_discovery.tls_skip_verify | string | lower }}
{% endif %}
{% endif %}

{% set s3_api = garage_install_configuration.s3_api %}
[s3_api]
api_bind_addr = "{{ s3_api.api_bind_addr | default('[::]:3900') }}"
s3_region = "{{ s3_api.s3_region | default('garage') }}"
{% if s3_api.root_domain is defined %}
root_domain = "{{ s3_api.root_domain }}"
{% endif %}

{% set s3_web = garage_install_configuration.s3_web %}
[s3_web]
bind_addr = "{{ s3_web.bind_addr | default('[::]:3902') }}"
{% if s3_web.root_domain is defined %}
root_domain = "{{ s3_web.root_domain }}"
{% endif %}
add_host_to_metrics = {{ s3_web.add_host_to_metrics | default(false) | string | lower }}

{% if garage_install_configuration.admin is defined %}
{% set admin = garage_install_configuration.admin %}
[admin]
{% if admin.api_bind_addr is defined %}
api_bind_addr = "{{ admin.api_bind_addr }}"
{% endif %}
{% if admin.admin_token is defined %}
admin_token = "{{ admin.admin_token }}"
{% endif %}
{% if admin.admin_token_file is defined %}
admin_token_file = "{{ admin.admin_token_file }}"
{% endif %}
{% if admin.metrics_token is defined %}
metrics_token = "{{ admin.metrics_token }}"
{% endif %}
{% if admin.metrics_token_file is defined %}
metrics_token_file = "{{ metrics.metrics_token_file }}"
{% endif %}
{% if admin.metrics_require_token is defined %}
metrics_require_token = {{ admin.metrics_require_token | string | lower }}
{% endif %}
{% if admin.trace_sink is defined %}
trace_sink = "{{ admin.trace_sink }}"
{% endif %}
{% endif %}